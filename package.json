{
  "name": "home-care-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:markdown": "markdownlint-cli2 \"README.md\" \"AGENTS.md\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/run-e2e.mjs",
    "test:db:prepare": "node scripts/prepare-test-database.mjs",
    "db:backup:local": "node scripts/backup-local-database.mjs",
    "supabase:project": "node scripts/supabase-project.mjs",
    "test:db:seed": "node scripts/seed-test-fixtures.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:db:sql": "node scripts/test-migrations.mjs --sql-only",
    "test:db:clean": "node scripts/clean-test-database.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.11",
    "@fluentui/react-icons": "2.0.344",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@zxing/browser": "0.2.1",
    "decimal.js": "10.6.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-react/eslint-plugin": "5.28.3",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "markdownlint-cli2": "0.24.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.21.1"
  },
  "packageManager": "npm@11.21.1",
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.19.0"
    }
  }
}
