                "example": "Adriana"
              },
              {
                "param_name": "nome_solicitante",
                "example": "Juliana"
              },
              {
                "param_name": "nome_paciente",
                "example": "Paciente Exemplo"
              },
              {
                "param_name": "numero_requisicao",
                "example": "REQ-0007"
              },
              {
