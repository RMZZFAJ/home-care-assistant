# Supabase autorizado para o ambiente; nunca usar credenciais reais nos testes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Somente servidor, após autenticar worker ou verificar assinatura de webhook.
SUPABASE_SERVICE_ROLE_KEY=
NOTIFICATIONS_WORKER_SECRET=
NOTIFICATIONS_EXTERNAL_ENABLED=false
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=
META_WHATSAPP_TEMPLATE=
META_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
META_WHATSAPP_DOCUMENT_TEMPLATE=
META_WHATSAPP_ACCEPTANCE_TEMPLATE=
META_WHATSAPP_URL_BUTTON_INDEX=0
META_FLOWS_ENABLED=false
META_FLOWS_PRIVATE_KEY=
META_FLOWS_PRIVATE_KEY_PASSPHRASE=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# PDF: JSON privado e política pública separados, exclusivos do servidor.
# Em Vercel usar valores protegidos por ambiente; nunca prefixar com NEXT_PUBLIC_.
HCA_PDF_SIGNING_SECRET=
HCA_PDF_TRUST_POLICY=
# Somente local: arquivos absolutos fora do workspace, em vez dos valores acima.
HCA_PDF_SIGNING_SECRET_FILE=
HCA_PDF_TRUST_POLICY_FILE=
